{
  "name": "auxilium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Auxilium \u2014 Health Sharing Ministry OS with Need Response Intelligence (NRI)",
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply auxilium-db-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply auxilium-db-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply auxilium-db-prod --remote --env production",
    "db:seed:local": "wrangler d1 execute auxilium-db-dev --local --file=./schema/seed.sql && wrangler d1 execute auxilium-db-dev --local --file=./schema/seed-integrity.sql",
    "db:seed:remote": "wrangler d1 execute auxilium-db-dev --remote --file=./schema/seed.sql && wrangler d1 execute auxilium-db-dev --remote --file=./schema/seed-integrity.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local && bun run db:seed:local",
    "db:studio:local": "wrangler d1 execute auxilium-db-dev --local --command",
    "cf:setup": "bash ./scripts/cloudflare-setup.sh",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "deploy:production": "bun run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.114.0"
  }
}
